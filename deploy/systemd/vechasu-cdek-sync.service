[Unit]
Description=Vechasu CDEK delivery status synchronization
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/clock-erp-current
EnvironmentFile=/etc/clock-erp/clock-erp.env
ExecCondition=/usr/bin/test ! -e /run/clock-erp-maintenance.json
ExecStart=/opt/clock-erp/venv/bin/python -m scripts.cdek_delivery_sync
TimeoutStartSec=240
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryLimit=256M
