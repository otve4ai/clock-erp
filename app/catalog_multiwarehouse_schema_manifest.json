  "triggers": [
    [
      "trg_erp_inventory_sessions_warehouse",
      "erp_inventory_sessions",
      "CREATE TRIGGER trg_erp_inventory_sessions_warehouse AFTER INSERT ON erp_inventory_sessions WHEN NEW.warehouse_id IS NULL BEGIN UPDATE erp_inventory_sessions SET warehouse_id='default' WHERE id=NEW.id; END"
    ],
    [
      "trg_erp_sales_warehouse",
      "erp_sales",
      "CREATE TRIGGER trg_erp_sales_warehouse AFTER INSERT ON erp_sales WHEN NEW.warehouse_id IS NULL BEGIN UPDATE erp_sales SET warehouse_id='default' WHERE id=NEW.id; END"
    ],
    [
      "trg_erp_writeoffs_warehouse",
      "erp_writeoffs",
      "CREATE TRIGGER trg_erp_writeoffs_warehouse AFTER INSERT ON erp_writeoffs WHEN NEW.warehouse_id IS NULL BEGIN UPDATE erp_writeoffs SET warehouse_id='default' WHERE id=NEW.id; END"
    ],
    [
      "trg_stock_movement_warehouse",
      "catalog_stock_movements",
      "CREATE TRIGGER trg_stock_movement_warehouse AFTER INSERT ON catalog_stock_movements WHEN NEW.warehouse_id IS NULL BEGIN UPDATE catalog_stock_movements SET warehouse_id=COALESCE((SELECT warehouse_id FROM erp_receipts WHERE id=NEW.receipt_id),(SELECT warehouse_id FROM erp_sales WHERE id=NEW.sale_id),'default') WHERE id=NEW.id; END"
    ],
    [
      "trg_ttt_component_insert",
      "erp_component_inventory",
      "CREATE TRIGGER trg_ttt_component_insert AFTER INSERT ON erp_component_inventory BEGIN INSERT OR REPLACE INTO erp_warehouse_stocks(warehouse_id,product_id,quantity,updated_at) VALUES('default',NEW.product_id,COALESCE(NEW.physical_stock,0),NEW.updated_at); END"
    ],
    [
      "trg_ttt_component_update",
      "erp_component_inventory",
      "CREATE TRIGGER trg_ttt_component_update AFTER UPDATE OF physical_stock ON erp_component_inventory BEGIN INSERT OR REPLACE INTO erp_warehouse_stocks(warehouse_id,product_id,quantity,updated_at) VALUES('default',NEW.product_id,COALESCE(NEW.physical_stock,0),NEW.updated_at); END"
    ],
    [
      "trg_ttt_product_insert",
      "catalog_excel_products",
      "CREATE TRIGGER trg_ttt_product_insert AFTER INSERT ON catalog_excel_products BEGIN INSERT OR REPLACE INTO erp_warehouse_stocks(warehouse_id,product_id,quantity,updated_at) VALUES('default',NEW.id,MAX(0,COALESCE(NEW.stock,0)),NEW.updated_at); END"
    ],
    [
      "trg_ttt_product_update",
      "catalog_excel_products",
      "CREATE TRIGGER trg_ttt_product_update AFTER UPDATE OF stock ON catalog_excel_products WHEN NOT EXISTS(SELECT 1 FROM erp_component_inventory WHERE product_id=NEW.id) BEGIN INSERT OR REPLACE INTO erp_warehouse_stocks(warehouse_id,product_id,quantity,updated_at) VALUES('default',NEW.id,MAX(0,COALESCE(NEW.stock,0)),NEW.updated_at); END"
    ]
  ],
