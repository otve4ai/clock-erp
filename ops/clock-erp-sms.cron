SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
*/5 * * * * root test ! -e /run/clock-erp-maintenance.json && cd /opt/clock-erp-current && flock -n /run/lock/clock-erp-sms-sync.lock /opt/clock-erp/venv/bin/flask --app app.web sms-sync-statuses >> /var/log/clock-erp-sms.log 2>&1
